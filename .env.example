# Copy to .env (git-ignored) and fill in. Load it with `uv run --env-file .env ...`,
# or once per shell with UV_ENV_FILE=.env.

# Anthropic API key (ADR-004). Only synthetic data is ever sent to the API.
ANTHROPIC_API_KEY=

# Database overrides: leave unset to use the development defaults of db/settings.py.
# DB_HOST=127.0.0.1
# DB_PORT=5434
# DB_NAME=safe_spending
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=postgres
